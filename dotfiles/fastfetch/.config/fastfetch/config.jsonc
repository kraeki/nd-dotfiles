// ndos fastfetch — the shell greeting. Logo colors: $1 teal, $2 peach
// (Catppuccin Mocha, matching branding/logo.svg).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "36",
      "2": "33"
    },
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": "cyan"
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    "separator",
    { "type": "os", "key": "os" },
    { "type": "kernel", "key": "kernel" },
    { "type": "wm", "key": "wm" },
    { "type": "uptime", "key": "up" },
    { "type": "packages", "key": "pkgs" },
    { "type": "terminal", "key": "term" },
    "separator",
    { "type": "cpu", "key": "cpu" },
    { "type": "gpu", "key": "gpu" },
    { "type": "memory", "key": "mem" },
    { "type": "disk", "key": "disk" },
    { "type": "battery", "key": "bat" },
    "break",
    "colors"
  ]
}
