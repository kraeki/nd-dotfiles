#!/usr/bin/env bash
#
# toggle-herdr [toggle|on|off|status] [-q]
#
# herdr (the terminal agent-multiplexer) on its own special workspace, bound to
# F3 -- the scratchpad counterpart of Slack (F1) and Obsidian (F2).
#
# Thin wrapper: toggle-scratchpad-app is the single implementation, shared with
# toggle-grok-bot. Everything herdr-specific is here in the arguments.
#
#   --class '^herdr$'  herdr is a TUI, so it flies as a kitty window under its
#                      OWN class (the cliamp trick) -- that is what makes it
#                      findable and what the window rule pins to the scratchpad.
#   --strip-env HERDR_ herdr refuses to start inside itself and would exit,
#                      taking kitty with it (see toggle-scratchpad-app).
#   --timeout 5        herdr restores its session/panes before mapping a window.
exec "$(dirname "$(readlink -f "$0")")/toggle-scratchpad-app" \
  --special herdr \
  --class '^herdr$' \
  --strip-env HERDR_ \
  --timeout 5 \
  --label herdr \
  "$@" -- kitty --class herdr -e herdr
