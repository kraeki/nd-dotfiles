#!/usr/bin/env bash

# Internet speed test, ported from Omarchy 4's `omarchy-network-speedtest`
# (shell/plugins/panels/speedtest drives it; the QML there is only the dials).
#
# How it measures, and why this beats speedtest-cli for a bar widget:
# fast.com hands out a few Netflix OCA endpoints, we saturate them with N
# parallel curl workers, and then read the *kernel's own* byte counters in
# /sys/class/net/<if>/statistics/. Nothing has to parse curl's progress meter,
# and because the counters are per-interface the number includes every retry
# and header byte actually on the wire.
#
# Usage: net-speedtest [down|up|both] [--seconds N] [--stream|--json|--notify]
#        net-speedtest --history [--here] [--limit N]
#
#   both      (default) download phase then upload phase
#   --stream  print live "down <mbps>" / "up <mbps>" lines, one per second,
#             then a final "result <down> <up>" line carrying the averages
#   --json    print {"download":N,"upload":N} once finished
#   --notify  post the result as a notification, sticky until dismissed
#   --no-log  do not append this run to the history
#   --history print past runs; --here limits them to the network you are on
#
# Every completed run is appended to
# ${XDG_STATE_HOME:-~/.local/state}/net-speedtest/history.jsonl -- one JSON
# object per line, carrying where you were (ssid, bssid, band, channel,
# signal, bitrate, gateway) alongside the numbers. BSSID is the useful key:
# an SSID can span a dozen APs and a dozen buildings, but a BSSID is one
# radio in one place, so "slow here" is a question the log can actually
# answer. JSONL rather than a single JSON array so appending never has to
# read, parse and rewrite the whole file.
#
# Traps worth keeping in mind:
#   - The first sample is always low: eight TCP connections are still in slow
#     start. It is dropped from the average rather than averaged in, which is
#     why --seconds below 3 is refused.
#   - Upload needs a body to push, hence `dd if=/dev/zero | curl --data-binary`.
#     The OCA endpoints accept POST and discard it.
#   - Killing the workers means killing curl, not just the subshell: each
#     worker is a `while` loop whose child curl would otherwise keep the link
#     saturated after we return. Hence `pkill -P` on each worker pid.

set -euo pipefail

direction=both
seconds=5
output=human
probe=1.1.1.1
parallel=8
url_count=3
log=true
history_limit=20
history_here=false

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/net-speedtest"
history_file="$state_dir/history.jsonl"

while (($#)); do
  case "$1" in
    down | up | both) direction=$1 ;;
    --seconds) seconds=${2:?--seconds needs a value}; shift ;;
    --stream) output=stream ;;
    --json) output=json ;;
    --notify) output=notify ;;
    --no-log) log=false ;;
    --history) output=history ;;
    --here) history_here=true ;;
    --limit) history_limit=${2:?--limit needs a value}; shift ;;
    -h | --help)
      awk '/^# Usage:/ { on = 1 } on && !/^#/ { exit } on { sub(/^# ?/, ""); print }' "$0"
      exit 0
      ;;
    *) echo "net-speedtest: unknown argument '$1'" >&2; exit 2 ;;
  esac
  shift
done

if [[ ! $seconds =~ ^[0-9]+$ ]] || ((seconds < 3)); then
  echo "net-speedtest: --seconds must be an integer >= 3 (the first sample is discarded as TCP slow start)" >&2
  exit 2
fi

# --- history ---------------------------------------------------------------
# Reads newest-first so --limit is a tail without parsing the whole file into
# a sorted array. Rows with a null download (an aborted run) are skipped.
# NOTE: `set -euo pipefail` makes early pipe closure fatal, which bit twice
# here and both times silently:
#   - `net-status | awk '... { exit }'` -- awk leaves after the match, the
#     write end gets SIGPIPE, pipefail promotes that to a failed pipeline and
#     -e kills the script mid-function with no message at all. The awk below
#     therefore reads to EOF and uses a seen-flag instead of `exit`.
#   - `jq | head -n N` -- same shape, head closing on jq. The pipeline's
#     output is captured into a variable with `|| true` rather than streamed,
#     which also makes "nothing matched" a state this can report.
render_history() {
  local filter='.' rows here

  if [[ $history_here == true ]]; then
    here=$(net-status --verbose 2>/dev/null |
      awk -F'\t' '$1 == "bssid" && !seen { print $2; seen = 1 }') || true
    if [[ -z ${here:-} ]]; then
      echo "net-speedtest: not on a Wi-Fi network, so there is no 'here' to filter by" >&2
      return 1
    fi
    filter="select(.bssid == \"$here\")"
  fi

  if [[ ! -r $history_file ]]; then
    echo "no speed tests logged yet ($history_file)" >&2
    return 1
  fi

  rows=$(tac "$history_file" |
    jq -rc "$filter | select(.download != null)" 2>/dev/null |
    head -n "$history_limit") || true

  if [[ -z ${rows:-} ]]; then
    if [[ $history_here == true ]]; then
      echo "no speed tests logged on this network yet" >&2
    else
      echo "no completed speed tests in the history yet" >&2
    fi
    return 1
  fi

  printf '%s\n' "$rows" |
    jq -r '
      def pad(n): tostring | (" " * (n - length) + .);
      [ (.ts | sub("T"; " ") | sub("[+-][0-9]{2}:[0-9]{2}$"; "") | .[5:16]),
        "  ↓" + ((.download // 0) | floor | pad(4)),
        "  ↑" + ((.upload   // 0) | floor | pad(4)),
        "   " + (.ssid // "?"),
        (if .band then "  (" + .band + ")" else "" end),
        (if .signal then "  " + (.signal | tostring) + "%" else "" end)
      ] | add'
}

if [[ $output == history ]]; then
  render_history
  exit $?
fi

for cmd in ip curl jq awk dd pkill; do
  command -v "$cmd" >/dev/null || { echo "net-speedtest: $cmd is required" >&2; exit 1; }
done

iface=$(ip route get "$probe" 2>/dev/null |
  awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')

if [[ -z ${iface:-} ]]; then
  echo "net-speedtest: no route to the internet" >&2
  exit 1
fi
for counter in rx_bytes tx_bytes; do
  [[ -r /sys/class/net/$iface/statistics/$counter ]] ||
    { echo "net-speedtest: cannot read $counter for $iface" >&2; exit 1; }
done

# The token is fast.com's own public web-client token, as shipped in Omarchy.
# It is not a credential; fast.com hands the same one to every browser.
fast_token="YXNkZmFzZGxmbnNkYWZoYXNkZmhrYWxm"
mapfile -t urls < <(
  curl -fsS "https://api.fast.com/netflix/speedtest/v2?https=true&token=$fast_token&urlCount=$url_count" 2>/dev/null |
    jq -r '.targets[]?.url // empty'
)

if ((${#urls[@]} == 0)); then
  echo "net-speedtest: could not fetch speed test endpoints from fast.com" >&2
  exit 1
fi

worker_pids=()

cleanup() {
  local pid
  for pid in "${worker_pids[@]:-}"; do
    [[ -n $pid ]] || continue
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill "$pid" 2>/dev/null || true
  done
  for pid in "${worker_pids[@]:-}"; do
    [[ -n $pid ]] || continue
    wait "$pid" 2>/dev/null || true
  done
  worker_pids=()
}
trap cleanup EXIT INT TERM

# Round-robin the endpoints so load spreads across OCA nodes rather than
# hammering whichever one came back first.
start_workers() {
  local dir=$1 i idx
  worker_pids=()
  for ((i = 0; i < parallel; i++)); do
    (
      idx=$((RANDOM))
      while true; do
        url=${urls[$((idx % ${#urls[@]}))]}
        if [[ $dir == down ]]; then
          curl -fsS -o /dev/null "$url" 2>/dev/null || exit 0
        else
          dd if=/dev/zero bs=1M count=64 2>/dev/null |
            curl -fsS -o /dev/null -X POST --data-binary @- "$url" 2>/dev/null || exit 0
        fi
        idx=$((idx + 1))
      done
    ) &
    worker_pids+=("$!")
  done
}

counter_for() { [[ $1 == down ]] && echo rx_bytes || echo tx_bytes; }

# Samples one direction for $seconds and leaves the average of samples 2..N
# (slow start excluded) in the global $result_mbps.
#
# The average goes in a global rather than on stdout precisely so that stdout
# stays free for --stream: a `$(measure down)` capture would otherwise swallow
# the live lines along with the result, and streaming would print nothing.
result_mbps=""
measure() {
  local dir=$1 counter file before after rate s
  local -a samples=()

  counter=$(counter_for "$dir")
  file=/sys/class/net/$iface/statistics/$counter

  start_workers "$dir"
  before=$(<"$file")

  for ((s = 1; s <= seconds; s++)); do
    sleep 1
    after=$(<"$file")
    rate=$(awk -v b="$before" -v a="$after" 'BEGIN {
      if (a < b) print 0; else printf "%.2f", (a - b) * 8 / 1000000
    }')
    before=$after
    samples+=("$rate")
    [[ $output == stream ]] && printf '%s %s\n' "$dir" "$rate"
  done

  cleanup

  result_mbps=$(printf '%s\n' "${samples[@]:1}" | awk '
    { sum += $1; n++ }
    END { if (n) printf "%.1f\n", sum / n; else print "0.0" }')
}

# The name of the connection under test, for the notification title.
conn_name() {
  net-status 2>/dev/null |
    awk -F'\t' '$1 == "wifi" { print $2 } $1 == "ethernet" { print "Ethernet" }'
}

# A fixed replace-id so the "running" notification turns into the result in
# place instead of stacking two. Clicking the bar is otherwise silent for the
# whole run (2 x --seconds plus the fast.com round trip), which reads as a
# dead element.
notify_id=9731
# -u critical is what makes the result stay put: dunstrc gives normal urgency
# timeout = 5 and only urgency_critical timeout = 0, so a plain notification
# was gone five seconds after a test you waited ten seconds for. The
# "measuring" one stays normal, since it is replaced by the result anyway.
notify_at() {
  notify-send -a net-speedtest -r "$notify_id" -i network-wireless \
    ${3:+-u "$3"} "$1" "$2"
}

name=""
if [[ $output == notify ]]; then
  name=$(conn_name)
  notify_at "Speed test${name:+ — $name}" "Measuring…"
fi

download=""
upload=""
if [[ $direction == down || $direction == both ]]; then
  measure down
  download=$result_mbps
fi
if [[ $direction == up || $direction == both ]]; then
  measure up
  upload=$result_mbps
fi

# --- log -------------------------------------------------------------------
# net-status --verbose is tab-separated key/value lines; jq -R -s turns that
# into an object so the record carries the whole context without this script
# knowing which keys exist. Numeric fields are coerced where they are numbers,
# because a history that stores "77" as a string cannot be compared or
# averaged later.
append_history() {
  local meta record
  mkdir -p "$state_dir" || return 0

  meta=$(net-status --verbose 2>/dev/null |
    jq -R -s 'split("\n") | map(select(length > 0) | split("\t"))
              | map(select(length == 2) | {(.[0]): .[1]}) | add // {}
              | with_entries(
                  if (.key | IN("freq", "signal", "channel", "rx_bytes", "tx_bytes",
                                "router_ping_ms", "internet_ping_ms", "speed"))
                     and (.value | test("^[0-9]+(\\.[0-9]+)?$"))
                  then .value |= tonumber else . end)')

  record=$(jq -nc \
    --argjson meta "${meta:-\{\}}" \
    --arg ts "$(date -Iseconds)" \
    --arg down "${download:-}" \
    --arg up "${upload:-}" \
    --argjson seconds "$seconds" \
    '$meta + {
       ts: $ts,
       seconds: $seconds,
       download: ($down | if . == "" then null else tonumber end),
       upload:   ($up   | if . == "" then null else tonumber end)
     }') || return 0

  printf '%s\n' "$record" >>"$history_file"
}

[[ $log == true ]] && append_history

case "$output" in
  stream)
    # The per-second samples are raw; this last line is what the run actually
    # measured (slow start dropped). A consumer drawing live gauges needs both
    # -- the samples to animate, this to settle on -- and should not have to
    # re-derive the average from lines it has already consumed.
    printf 'result %s %s\n' "${download:-0}" "${upload:-0}"
    ;;
  json)
    jq -nc --arg d "${download:-}" --arg u "${upload:-}" \
      '{download: ($d | if . == "" then null else tonumber end),
        upload:   ($u | if . == "" then null else tonumber end)}'
    ;;
  notify)
    body=""
    [[ -n $download ]] && body="↓ ${download} Mbps"
    [[ -n $upload ]] && body="${body:+$body   }↑ ${upload} Mbps"
    notify_at "Speed test${name:+ — $name}" "$body" critical
    printf '%s\n' "$body"
    ;;
  human)
    [[ -n $download ]] && printf 'download  %s Mbps\n' "$download"
    [[ -n $upload ]] && printf 'upload    %s Mbps\n' "$upload"
    ;;
esac
